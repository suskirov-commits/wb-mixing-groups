{
  "name": "Смесительный узел",
  "manufacturer": "wbmix",
  "model": "Смесительный узел",
  "modelIds": [
    "/devices/([0-9a-zA-Z_]+)/controls/pid_i/meta"
  ],
  "services": [
    {
      "name": "Уставка выхода",
      "type": "Thermostat",
      "characteristics": [
        {
          "type": "CurrentTemperature",
          "link": [
            {
              "type": "Double",
              "topicGet": "/devices/(1)/controls/t_mix"
            }
          ]
        },
        {
          "type": "TargetTemperature",
          "link": [
            {
              "type": "Double",
              "topicGet": "/devices/(1)/controls/setpoint",
              "topicSet": "/devices/(1)/controls/setpoint/on"
            }
          ],
          "minValue": 20,
          "maxValue": 70,
          "minStep": 1
        },
        {
          "type": "CurrentHeatingCoolingState",
          "link": [
            {
              "type": "Integer",
              "topicGet": "/devices/(1)/controls/enabled",
              "map": {
                "OFF": "0",
                "HEAT": "1"
              }
            }
          ],
          "validValues": "OFF,HEAT"
        },
        {
          "type": "TargetHeatingCoolingState",
          "link": [
            {
              "type": "Integer",
              "topicGet": "/devices/(1)/controls/enabled",
              "topicSet": "/devices/(1)/controls/enabled/on",
              "map": {
                "OFF": "0",
                "HEAT": "1"
              }
            }
          ],
          "validValues": "OFF,HEAT"
        },
        {
          "type": "TemperatureDisplayUnits",
          "validValues": "CELSIUS",
          "option": true
        }
      ]
    },
    {
      "name": "Авария",
      "type": "ContactSensor",
      "characteristics": [
        {
          "type": "ContactSensorState",
          "link": [
            {
              "type": "Integer",
              "topicGet": "/devices/(1)/controls/alarm"
            }
          ]
        }
      ]
    }
  ],
  "options": [
    {
      "name": "Состояние",
      "type": "String",
      "link": [
        {
          "type": "String",
          "topicGet": "/devices/(1)/controls/state"
        }
      ],
      "inputType": "STATUS"
    },
    {
      "name": "Описание аварии",
      "type": "String",
      "link": [
        {
          "type": "String",
          "topicGet": "/devices/(1)/controls/alarm_text"
        }
      ],
      "inputType": "STATUS"
    }
  ]
}
