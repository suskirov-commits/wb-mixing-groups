{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "title": "mixingGroupsTitle",
  "description": "mixingGroupsDescription",
  "configFile": {
    "path": "/etc/wb-mixing-groups.conf",
    "service": "wb-rules"
  },
