          "options": {
            "patternmessage": "errMqttTopic",
            "inputAttributes": {
              "placeholder": "phMqttTopic"
            },
            "wb": {
              "data": "devices"
            },
            "grid_columns": 6
          },
          "title": "actFeedbackTitle",
          "description": "actFeedbackDescription",
          "propertyOrder": 6
        },
        "rateLimit": {
          "type": "number",
          "title": "actRateLimitTitle",
          "description": "actRateLimitDescription",
          "minimum": 0,
          "maximum": 100,
          "default": 0,
          "propertyOrder": 7,
          "options": {
            "grid_columns": 6
          }
        },
        "posMin": {
          "type": "number",
          "title": "actPosMinTitle",
          "description": "actPosMinDescription",
          "minimum": 0,
          "maximum": 100,
          "default": 0,
          "propertyOrder": 20,
          "options": {
            "grid_columns": 6
          }
        },
        "posMax": {
          "type": "number",
          "title": "actPosMaxTitle",
          "minimum": 0,
          "maximum": 100,
          "default": 100,
          "propertyOrder": 21,
          "options": {
            "grid_columns": 6
