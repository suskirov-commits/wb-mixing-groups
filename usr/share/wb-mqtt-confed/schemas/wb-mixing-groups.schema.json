        "vMin": {
          "type": "number",
          "title": "actVMinTitle",
          "description": "actVMinDescription",
          "default": 0,
          "propertyOrder": 3,
          "options": {
            "grid_columns": 4
          }
        },
        "vMax": {
          "type": "number",
          "title": "actVMaxTitle",
          "default": 10000,
