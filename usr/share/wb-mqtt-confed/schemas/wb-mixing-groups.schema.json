    "tristateActuator": {
      "type": "object",
      "title": "actTristateTitle",
      "description": "actTristateDescription",
      "_format": "grid",
      "options": {
        "disable_collapse": true,
        "disable_edit_json": true
      },
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "tristate"
          ],
          "default": "tristate",
          "options": {
            "hidden": true
          }
        },
        "open": {
          "type": "string",
          "pattern": "^$|^[^/+#]+/[^/+#]+$",
          "minLength": 0,
          "_format": "wb-autocomplete",
          "options": {
            "patternmessage": "errMqttTopic",
            "inputAttributes": {
              "placeholder": "phMqttTopic"
            },
            "wb": {
              "data": "devices"
            },
            "grid_columns": 6
          },
          "title": "actOpenTitle",
          "description": "actOpenDescription",
          "propertyOrder": 1
        },
        "close": {
          "type": "string",
          "pattern": "^$|^[^/+#]+/[^/+#]+$",
          "minLength": 0,
          "_format": "wb-autocomplete",
          "options": {
            "patternmessage": "errMqttTopic",
            "inputAttributes": {
              "placeholder": "phMqttTopic"
            },
            "wb": {
              "data": "devices"
            },
            "grid_columns": 6
          },
          "title": "actCloseTitle",
          "description": "actCloseDescription",
          "propertyOrder": 2
        },
        "travelTime": {
          "type": "number",
          "title": "actTravelTimeTitle",
          "description": "actTravelTimeDescription",
          "minimum": 5,
          "maximum": 600,
          "default": 120,
          "propertyOrder": 3,
          "options": {
            "grid_columns": 6
          }
        },
        "travelTimeClose": {
          "type": "number",
          "title": "actTravelTimeCloseTitle",
          "description": "actTravelTimeCloseDescription",
          "minimum": 5,
          "maximum": 600,
          "default": 120,
          "propertyOrder": 4,
          "options": {
            "grid_columns": 6
          }
        },
        "minPulse": {
          "type": "integer",
          "title": "actMinPulseTitle",
          "description": "actMinPulseDescription",
          "minimum": 100,
          "maximum": 5000,
          "default": 500,
          "propertyOrder": 5,
          "options": {
            "grid_columns": 4
          }
        },
        "deadband": {
          "type": "number",
          "title": "actDeadbandTitle",
          "description": "actDeadbandDescription",
          "minimum": 0.2,
          "maximum": 20,
          "default": 1.5,
          "propertyOrder": 6,
          "options": {
            "grid_columns": 4
          }
        },
        "interlock": {
          "type": "integer",
          "title": "actInterlockTitle",
          "description": "actInterlockDescription",
          "minimum": 0,
          "maximum": 5000,
          "default": 300,
          "propertyOrder": 7,
          "options": {
            "grid_columns": 4
          }
        },
        "invert": {
          "type": "boolean",
          "title": "actInvertTitle",
          "description": "actInvertDescription",
          "default": false,
          "_format": "checkbox",
          "propertyOrder": 8,
          "options": {
            "grid_columns": 6
          }
        },
        "recalibrateAfter": {
          "type": "number",
          "title": "actRecalibrateTitle",
          "description": "actRecalibrateDescription",
          "minimum": 100,
          "maximum": 5000,
          "default": 500,
          "propertyOrder": 9,
          "options": {
            "grid_columns": 6
          }
        },
        "posMin": {
          "type": "number",
          "title": "actPosMinTitle",
          "description": "actPosMinDescription",
          "minimum": 0,
          "maximum": 100,
          "default": 0,
          "propertyOrder": 20,
          "options": {
            "grid_columns": 6
          }
        },
        "posMax": {
          "type": "number",
          "title": "actPosMaxTitle",
          "minimum": 0,
          "maximum": 100,
          "default": 100,
          "propertyOrder": 21,
          "options": {
            "grid_columns": 6
          }
